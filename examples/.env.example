# 复制为 .env 后填写：cp .env.example .env

# 必填：root 的 SSH 密码
SSH_ROOT_PASSWORD=change-me-to-a-strong-password

# 可选：Web 的 Basic Auth（两个都填才生效）
# PROXY_USERNAME=admin
# PROXY_PASSWORD=change-me

# 可选：容器内 gh 用的 token（fine-grained、单仓库、短期）
# GH_TOKEN=github_pat_xxxxxxxx

# 可选：改用公钥登录（推荐），同时关掉密码登录
# SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@laptop
# SSH_PASSWORD_AUTHENTICATION=no
